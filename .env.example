# PostgreSQL
POSTGRES_DB=history
POSTGRES_USER=history
POSTGRES_PASSWORD=history

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_PASSWORD=history
NEO4J_URI=bolt://localhost:7687

# FastAPI
API_ENV=development
LOG_LEVEL=INFO

# Map tiles (frontend only) - MapLibre needs no token
# Use a free tile provider URL, e.g. OpenFreeMap or self-hosted
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
